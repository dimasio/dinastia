# Локальная разработка (скилл local-env). Скопировать в .env; значения подходят для docker/compose.yml.
# Секреты прода здесь не хранятся.

# Порты
API_PORT=3000
WEB_PORT=5173
DB_PORT=5432
S3_PORT=8333
S3_UI_PORT=8888
SMTP_PORT=1025
MAILPIT_PORT=8025

# Домен: корень — APP_DOMAIN, школы — <slug>.APP_DOMAIN. Локально *.localhost резолвится в 127.0.0.1 сам.
APP_DOMAIN=dinastia.localhost
APP_PROTOCOL=http
# Публичный порт веба (в адресах писем и trustedOrigins); в проде — пусто
APP_PUBLIC_PORT=5173

# PostgreSQL 18 (D-030): приложение — app_user (RLS), миграции — app_owner
DATABASE_URL=postgres://app_user:app_user@localhost:5432/dinastia
DATABASE_URL_OWNER=postgres://app_owner:app_owner@localhost:5432/dinastia
DATABASE_URL_TEST=postgres://app_user:app_user@localhost:5432/dinastia_test
DATABASE_URL_TEST_OWNER=postgres://app_owner:app_owner@localhost:5432/dinastia_test

# S3 (локально SeaweedFS, D-037)
S3_ENDPOINT=http://localhost:8333
S3_REGION=ru-central1
S3_BUCKET=dinastia
S3_ACCESS_KEY=dinastia
S3_SECRET_KEY=dinastia-secret
S3_FORCE_PATH_STYLE=true

# Почта (локально Mailpit); MAIL_TRANSPORT=memory — письма копятся в памяти (тесты)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_FROM=Dinastia <noreply@dinastia.localhost>

# Сколько прокси перед API добавляют X-Forwarded-For (локально — прокси Vite = 1; в проде — по схеме ingress).
# IP клиента для rate limit и журнала берётся только из доверенных звеньев — подделать его клиент не может.
TRUST_PROXY_HOPS=1

# Auth (better-auth): любая длинная случайная строка
AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef

# Провайдеры (D-023): fake — без сети и ключей
VIDEO_PROVIDER=fake
