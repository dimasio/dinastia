{
	"name": "@dinastia/api",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "tsx watch --clear-screen=false src/dev.ts",
		"build": "tsx build.ts",
		"start": "node dist/main.js",
		"worker": "node dist/worker.js",
		"start:all": "tsx src/dev.ts",
		"emails:preview": "tsx src/emails-preview.ts",
		"jobs:list": "tsx src/jobs-cli.ts list",
		"jobs:run": "tsx src/jobs-cli.ts run",
		"typecheck": "tsc -p .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/kernel/db/cli.ts migrate",
		"db:reset": "tsx src/kernel/db/cli.ts reset",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/seed.ts",
		"db:seed:trud": "tsx src/seed-trud.ts",
		"check:registries": "tsx src/check-registries.ts",
		"ops:grant": "tsx src/ops-grant.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "catalog:",
		"@aws-sdk/s3-request-presigner": "catalog:",
		"@dinastia/blocks": "workspace:*",
		"@dinastia/contracts": "workspace:*",
		"@dinastia/db": "workspace:*",
		"@dinastia/i18n": "workspace:*",
		"@dinastia/questions": "workspace:*",
		"@fontsource/pt-sans": "5.3.0",
		"@fontsource/pt-serif": "5.3.0",
		"@hono/node-server": "catalog:",
		"@orpc/contract": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@react-email/render": "catalog:",
		"@sentry/node": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"fflate": "0.8.3",
		"hono": "catalog:",
		"i18next": "catalog:",
		"nodemailer": "catalog:",
		"pg": "catalog:",
		"pg-boss": "catalog:",
		"pino": "catalog:",
		"playwright-core": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-email": "catalog:",
		"uqr": "0.1.3",
		"write-excel-file": "4.1.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@dinastia/config": "workspace:*",
		"@orpc/client": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"drizzle-kit": "catalog:",
		"esbuild": "catalog:",
		"pino-pretty": "catalog:",
		"read-excel-file": "^9.3.14",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"unpdf": "2.1.0",
		"vitest": "catalog:"
	}
}
