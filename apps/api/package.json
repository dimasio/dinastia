{
	"name": "@dinastia/api",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "tsx watch --clear-screen=false src/dev.ts",
		"start": "tsx src/main.ts",
		"worker": "tsx src/worker.ts",
		"start:all": "tsx src/dev.ts",
		"emails:preview": "tsx src/emails-preview.ts",
		"jobs:list": "tsx src/jobs-cli.ts list",
		"jobs:run": "tsx src/jobs-cli.ts run",
		"typecheck": "tsc -p .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/kernel/db/cli.ts migrate",
		"db:reset": "tsx src/kernel/db/cli.ts reset",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/seed.ts"
	},
	"dependencies": {
		"@dinastia/contracts": "workspace:*",
		"@dinastia/db": "workspace:*",
		"@dinastia/i18n": "workspace:*",
		"@hono/node-server": "catalog:",
		"@orpc/contract": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@react-email/render": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"i18next": "catalog:",
		"nodemailer": "catalog:",
		"pg": "catalog:",
		"pg-boss": "catalog:",
		"pino": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-email": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@dinastia/config": "workspace:*",
		"@orpc/client": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"drizzle-kit": "catalog:",
		"pino-pretty": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
