{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/.turbo",
			"!**/routeTree.gen.ts",
			"!apps/api/drizzle",
			"!**/*.md",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"security": {
				"noDangerouslySetInnerHtml": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/api/src/modules/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"#/kernel/db/client.ts": "Модулям — только ctx.db (транзакция школы с RLS), скилл data-access. Исключение — с комментарием biome-ignore и причиной.",
									"drizzle-orm/node-postgres": "Модулям — только ctx.db, скилл data-access."
								}
							}
						}
					}
				}
			}
		}
	]
}
